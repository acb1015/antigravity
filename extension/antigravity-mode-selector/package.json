{
  "name": "antigravity-mode-selector",
  "displayName": "Antigravity AI Mode Selector",
  "description": "Cursor-style Mode Selector in Chat Toolbar for Antigravity AI modes (Ask, Plan, Debug, Agent)",
  "version": "1.1.0",
  "publisher": "acb",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "antigravity.selectMode",
        "title": "AI Mode 선택",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.quickToggle",
        "title": "Ask ↔ Agent 토글",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.setAskMode",
        "title": "Set Mode: Ask (Read-Only)",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.setPlanMode",
        "title": "Set Mode: Plan (Planning)",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.setDebugMode",
        "title": "Set Mode: Debug (Bug Fixing)",
        "category": "Antigravity"
      },
      {
        "command": "antigravity.setAgentMode",
        "title": "Set Mode: Agent (Full Agent)",
        "category": "Antigravity"
      }
    ],
    "keybindings": [
      {
        "command": "antigravity.selectMode",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m"
      },
      {
        "command": "antigravity.quickToggle",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      }
    ]
  }
}